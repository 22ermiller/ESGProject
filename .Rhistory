library(dplyr)
library(knitr)
#Generate the data
set.seed(588)
n <- 200
x <- rnorm(n, mean = 0, sd = 1)
X <- cbind(rep(1, n), x)
beta <- c(1, 0.5)
eta <- X%*%beta
mu <- exp(eta)  # mean
y_pois <- rpois(n, mu)  # Poisson data
y_nb <- rnbinom(n, size = 5, mu = mu)  # Overdispersed data (Negative Binomial)
#Exploratory Plots
par(mfrow=c(2,2))
hist(y_pois, xlim=range(c(y_pois, y_nb)))
hist(y_nb, xlim=range(c(y_pois, y_nb)))
plot(x, y_pois, ylim=range(c(y_pois, y_nb)))
plot(x, y_nb, ylim=range(c(y_pois, y_nb)))
#Summarize Response Variables
summary_table <- data.frame(
Variable = c("y_pois", "y_nb"),
Mean = c(mean(y_pois), mean(y_nb)),
Variance = c(var(y_pois), var(y_nb)),
Min = c(min(y_pois), min(y_nb)),
Max = c(max(y_pois), max(y_nb)),
Median = c(median(y_pois), median(y_nb)),
SD = c(sd(y_pois), sd(y_nb))
)
kable(summary_table, format = "markdown", digits = 2, caption = "Summary Statistics for y_pois and y_nb")
modpois1 <- glm(y_pois~x, family="poisson")
modpois2 <- glm(y_nb~x, family="poisson")
summary(modpois1)
summary(modpois2)
par(mfrow=c(2,2))
plot(modpois1)
par(mfrow=c(2,2))
plot(modpois2)
#Compute dispersion estimate by summing squared Pearson residuals
phi1 <- sum(residuals(modpois1, type = "pearson")^2) / modpois1$df.residual
phi2 <- sum(residuals(modpois2, type = "pearson")^2) / modpois2$df.residual
cat("Dispersion statistic for Poisson model on Poisson data:", phi1, "\n")
cat("Dispersion statistic for Poisson model on NB data:", phi2, "\n")
#Determine the dispersion by using a quasi-Poisson model
modqp1 <- glm(y_pois~x, family="quasipoisson")
modqp2 <- glm(y_nb~x, family="quasipoisson")
summary(modqp1)
summary(modqp2)
#p-values for the two estimated dispersion
pval1 <- 1-pchisq(phi1*(length(y_pois)-2), length(y_pois)-2)
pval2 <- 1-pchisq(phi2*(length(y_pois)-2), length(y_nb)-2)
cat("P-value for Dispersion Statistic on Poisson data:", pval1, "\n")
cat("P-value for Dispersion Statistic on NB data:", pval2, "\n")
library(MASS) #Need this library to fit the negative binomial model
#Fit the negative binomial regression models to this data
modnb1 <- glm.nb(y_pois ~ x)
modnb2 <- glm.nb(y_nb~x)
#Parameter estimates
summary(modnb1)
summary(modnb2)
#Plot of residuals
par(mfrow=c(2,2))
plot(modnb1)
par(mfrow=c(2,2))
plot(modnb2)
#Summaries to compare some model measures between Poisson (or quasi-Poisson) and Negative Binomial models
summary_table <- data.frame(
Variable = c("y_pois", "y_nb"),
Pois_Deviance = c(modpois1$deviance, modpois2$deviance),
NB_Deviance = c(modnb1$deviance, modnb1$deviance),
Pois_AIC = c(AIC(modpois1), AIC(modpois2)),
NB_AIC = c(AIC(modnb1), AIC(modnb2)),
Disp_QPois = c(summary(modqp1)$dispersion, summary(modqp2)$dispersion),
Disp_NB = c(modnb1$theta, modnb2$theta)
)
kable(summary_table, format = "markdown", digits = 2, caption = "Overdispersion Measures for Poisson and NB Models")
disp.nbmod2 <- 1 + predict(modnb2, type="response")/modnb2$theta
hist(disp.nbmod2, main="Dispersion from NB Model on NB Data", xlab="x", freq=F)
abline(v=summary(modqp2)$dispersion, col='red', lwd=2)
abline(v=mean(disp.nbmod2), col='blue', lwd=2, lty=2)
text(summary(modqp2)$dispersion, .6, labels="Quasi-Poisson Disp.", col='red', pos=4)
text(mean(disp.nbmod2), .8, labels="Mean NB Disp.", col='blue', pos=4)
#Generate the data
set.seed(588)
n <- 200
x <- rnorm(n, mean = 0, sd = 1)
X <- cbind(rep(1, n), x)
beta <- c(1, 0.5)
eta <- X%*%beta
mu <- exp(eta)  # mean
y_pois <- rpois(n, mu)  # Poisson data
y_nb <- rnbinom(n, size = 5, mu = mu)  # Overdispersed data (Negative Binomial)
#Exploratory Plots
par(mfrow=c(2,2))
hist(y_pois, xlim=range(c(y_pois, y_nb)))
hist(y_nb, xlim=range(c(y_pois, y_nb)))
