fasting_pca <- prcomp(fasting)
fasting_fve <- fasting_pca$sdev^2/sum(fasting_pca$sdev^2) # fraction of variance explained
cumsum(fasting_fve)
# 1) Scree plot
plot(cumsum(fasting_fve), type = "b", xlab = "Principal component", ylab = "Proportion variance explained")
sugar_pca <- prcomp(sugar)
sugar_fvs <- sugar_pca$sdev^2/sum(sugar_pca$sdev^2) # fraction of variance explained
cumsum(sugar_fvs)
# 1) Scree plot
plot(cumsum(sugar_fvs), type = "b", xlab = "Principal component", ylab = "Proportion variance explained")
# 2) Loadings (rotation)
round(fasting_fve$rotation[, 1:2], 3)
sugar_fvs
fasting_fve
sugar_fvs
# 2) Loadings (rotation)
round(fasting_fve$rotation[, 1:2], 3)
fasting_fve
cumsum(fasting_fve)
# 2) Loadings (rotation)
round(fasting_pca$rotation[, 1:2], 3)
# 2) Loadings (rotation)
round(sugar_pca$rotation[, 1:2], 3)
